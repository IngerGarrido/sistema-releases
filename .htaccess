# ─── Sistema · Configuración Apache para shared hosting ──────────
# El entry point real es index.php (que sirve el SPA reescribiendo
# las rutas de assets), por eso casi no necesitamos mod_rewrite.
# Si mod_rewrite está disponible aprovechamos para que /assets/...
# absoluto también funcione, pero no es obligatorio.
# ─────────────────────────────────────────────────────────────────

DirectoryIndex index.php index.html
Options -Indexes

# Nada de esto se sirve nunca: comprimidos, notas internas, scripts ni repositorio.
<FilesMatch "\.(zip|tar|gz|md|sh|sql|log|lock|bak)$">
  Require all denied
</FilesMatch>
<IfModule mod_alias.c>
  RedirectMatch 404 ^(.*/)?\.(git|claude|agents|github)(/|$)
  RedirectMatch 404 ^(.*/)?(docs|frontend/src|frontend/node_modules)(/|$)
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Link público de aprobación de cotizaciones: /c/{token} y /c/{token}/pdf
  # (lo único del sistema que se ve sin login).
  # Propuesta adjunta (opcional): HTML para el iframe y PDF para descargar.
  RewriteRule ^c/([A-Za-z0-9_-]{43})/propuesta\.pdf$ backend/publico/cotizacion.php?t=$1&propuesta=pdf [L,QSA]
  RewriteRule ^c/([A-Za-z0-9_-]{43})/propuesta/?$ backend/publico/cotizacion.php?t=$1&propuesta=html [L,QSA]
  RewriteRule ^c/([A-Za-z0-9_-]{43})/pdf/?$ backend/publico/cotizacion.php?t=$1&pdf=1 [L,QSA]
  RewriteRule ^c/([A-Za-z0-9_-]{43})/?$ backend/publico/cotizacion.php?t=$1 [L,QSA]

  # Acta de entrega (módulo Entregas): /e/{token}, /e/{token}/acta, /acta.pdf,
  # /confirmar y /observacion. También pública, sin login.
  RewriteRule ^e/([A-Za-z0-9_-]{43})/acta\.pdf$ backend/publico/entrega.php?t=$1&r=pdf [L,QSA]
  RewriteRule ^e/([A-Za-z0-9_-]{43})/(acta|confirmar|observacion)/?$ backend/publico/entrega.php?t=$1&r=$2 [L,QSA]
  RewriteRule ^e/([A-Za-z0-9_-]{43})/?$ backend/publico/entrega.php?t=$1 [L,QSA]

  # Integración con Claude Code (llave de API, sin sesión): subir propuestas y actas.
  # La cabecera Authorization se pasa explícita (algunos hostings la descartan).
  RewriteRule ^api/integracion/(cotizaciones|documentos)/?$ backend/api/integracion.php?r=$1 [L,QSA,E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # /backend/... pasa tal cual
  RewriteRule ^backend/ - [L]

  # Archivos o carpetas que existan físicamente, servir tal cual
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /assets/... → /frontend/dist/assets/... (por si algún build viejo
  # quedó con rutas absolutas)
  RewriteRule ^assets/(.*)$ frontend/dist/assets/$1 [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

# ─── Compresión gzip (reduce JS/CSS ~70%) ───────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/x-font-ttf application/x-font-otf
</IfModule>

# ─── Cache de assets versionados (los hashes en el nombre ya invalidan al cambiar) ─
<IfModule mod_expires.c>
  ExpiresActive On

  # Assets de Vite (tienen hash → cache 1 año)
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imágenes — 1 mes
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    ExpiresDefault "access plus 1 month"
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML — no cachear (debe refetch para detectar updates)
  <FilesMatch "\.(html|php)$">
    ExpiresActive Off
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # PWA: sw.js y manifest deben revalidar siempre
  <FilesMatch "(sw\.js|manifest\.json)$">
    ExpiresActive Off
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </FilesMatch>
</IfModule>

# ─── Security headers ───────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HSTS (solo si tu sitio siempre va a estar en HTTPS — sistema.ingergarrido.cl tiene SSL)
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
